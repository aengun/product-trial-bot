# Slack 앱의 Incoming Webhooks에서 발급받은 주소를 로컬 .env에 넣으세요.
# config.json의 notifications.slack도 true로 설정합니다.
SLACK_WEBHOOK_URL=

# 슬랙 스레드 답장으로 승인하려면 아래 항목도 설정합니다.
# Bot User OAuth Token (OAuth & Permissions)
SLACK_BOT_TOKEN=
# App-Level Token (Basic Information), connections:write 권한
SLACK_APP_TOKEN=
# 본인 Slack 멤버 ID (프로필의 멤버 ID 복사)
SLACK_APPROVER_USER_ID=
# 알림 채널 ID (채널 상세 정보에서 확인)
SLACK_CHANNEL_ID=

# 29CM·4910 봇은 이 파일이 아니라 .env.29cm / .env.4910 에 각 플랫폼 전용 Slack 앱 값을 넣습니다.
# (SLACK_BOT_TOKEN, SLACK_APP_TOKEN, SLACK_CHANNEL_ID / 승인자 ID는 생략 시 이 파일 값 사용)
